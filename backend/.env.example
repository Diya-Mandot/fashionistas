# Copy to backend/.env and fill in. Never commit .env (it's gitignored).

# --- Anthropic key: powers BOTH the stylist agent and outfit scoring / item classification ---
# Create at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
# AGENTS_MODEL=claude-opus-5-5
# DECISIONS_MODEL=claude-opus-5-5
# AGENTS_EFFORT=low
# DECISIONS_EFFORT=low

# live (default) | replay (recorded real responses) | mock (synthetic, last resort)
AGENTS_MODE=live
DECISIONS_MODE=live
# Optional HTTPS URL for a palette-evidence.json file served by your LlamaPress app.
# LLAMAPRESS_PALETTE_URL=
# Optional absolute path to a private profile photo. The stylist sends it to Claude for color analysis.
# STYLIST_PROFILE_PHOTO_PATH=

# --- Google Vision (closet scan, optional) ---
# Auth is tried in this order; you only need one:
#   1. GOOGLE_VISION_API_KEY
#   2. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#   3. Nothing here: uses `gcloud auth application-default login` (same as the capstone)
GOOGLE_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Calendar sync (optional, recommended) ---
# OAuth client from Google Cloud Console (APIs & Services -> Credentials -> OAuth client ID ->
# "Web application"). Add this exact Authorized redirect URI to the client:
#   http://localhost:8000/api/calendar/google/callback
# Then click "Connect Google Calendar" on the home page. The refresh token is stored in
# backend/private_calendar/google_token.json (gitignored). Read-only access.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only change if the backend runs somewhere other than localhost:8000 (must match the console exactly)
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
# primary (default) | comma-separated calendar IDs | all (every calendar ticked in Google Calendar)
# GOOGLE_CALENDAR_IDS=primary

# --- Real calendar via iCal link (optional alternative, no OAuth) ---
# Private iCal address of your calendar. Google Calendar: Settings -> pick your calendar ->
# "Integrate calendar" -> "Secret address in iCal format". Apple/Outlook ICS links work too.
# Also accepts a Google Calendar *export* (Settings -> Import & export -> Export): unzip it into
# backend/private_calendar/ (gitignored) and point here at that folder. Exports are a snapshot.
# Several sources can be comma-separated. Without it (or Google Calendar), no events are read.
CALENDAR_ICS_URL=

# --- Location ---
# Fallback home city when the browser location isn't shared and the message names no city
HOME_CITY=San Francisco

# Dev-only endpoints such as POST /api/dev/reset
DEV_ENDPOINTS=true
