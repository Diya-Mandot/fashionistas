# Copy to backend/.env and fill in. Never commit .env (it's gitignored).

# --- OpenAI key: powers BOTH the Agents API and the Decisions API ---
# Create at https://platform.openai.com/api-keys in the project that has the hackathon credits.
OPENAI_API_KEY=

# live (default) | replay (recorded real responses) | mock (synthetic, last resort)
AGENTS_MODE=live
DECISIONS_MODE=live

# --- Google Vision (closet scan, optional) ---
# Auth is tried in this order; you only need one:
#   1. GOOGLE_VISION_API_KEY
#   2. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#   3. Nothing here: uses `gcloud auth application-default login` (same as the capstone)
GOOGLE_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Real calendar (optional) ---
# Private iCal address of your calendar. Google Calendar: Settings -> pick your calendar ->
# "Integrate calendar" -> "Secret address in iCal format". Apple/Outlook ICS links work too.
# Without it, the seeded demo calendar is used.
CALENDAR_ICS_URL=
# Also show the seeded demo trips alongside your real events (default: only when no real calendar)
# CALENDAR_INCLUDE_DEMO=true

# --- Location ---
# Fallback home city when the browser location isn't shared and the message names no city
HOME_CITY=San Francisco

# Dev-only endpoints such as POST /api/dev/reset
DEV_ENDPOINTS=true
