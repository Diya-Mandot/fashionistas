# Copy to backend/.env and fill in. Never commit .env.

# --- Hackathon Agents API ---
AGENTS_API_KEY=
AGENTS_API_BASE_URL=
# live (default) | replay (recorded real responses) | mock (synthetic, last resort)
AGENTS_MODE=live

# --- Hackathon Decisions API ---
DECISIONS_API_KEY=
DECISIONS_API_BASE_URL=
DECISIONS_MODE=live

# --- Google Vision (closet scan). Use ONE of these. ---
GOOGLE_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Dev-only endpoints such as POST /api/dev/reset
DEV_ENDPOINTS=true
