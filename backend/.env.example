# Copy to backend/.env and fill in. Never commit .env (it's gitignored).

# --- OpenAI key: powers BOTH the Agents API and the Decisions API ---
# Create at https://platform.openai.com/api-keys in the project that has the hackathon credits.
OPENAI_API_KEY=

# live (default) | replay (recorded real responses) | mock (synthetic, last resort)
AGENTS_MODE=live
DECISIONS_MODE=live
AGENTS_MODEL=gpt-6-astra
DECISIONS_MODEL=gpt-6-luna
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_TURNS=10

# Open-Meteo needs no API key for this noncommercial demo.
WEATHER_TIMEOUT_SECONDS=8
WEATHER_TOTAL_TIMEOUT_SECONDS=20
WEATHER_CACHE_SECONDS=1800

# Current scanner: OpenAI image understanding followed by Decisions tags.
SCAN_VISION_MODEL=gpt-6-astra
SCAN_VISION_MODE=live
SCAN_TIMEOUT_SECONDS=120

# Legacy Google Vision settings. The current scanner does not require these.
GOOGLE_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Dev-only endpoints such as POST /api/dev/reset
DEV_ENDPOINTS=true
